---
---
<header class="w-full flex justify-between items-center px-6 py-5 bg-white/70 backdrop-blur-md border-b border-slate-200/50 shadow-sm sticky top-0 z-40">
  <div class="flex items-center gap-3">
    <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center shadow-inner border border-blue-100">
      <span class="material-symbols-outlined text-blue-600 text-xl" data-icon="sensors">sensors</span>
    </div>
    <div class="flex flex-col">
      <h1 class="text-lg md:text-xl font-bold text-slate-800 tracking-tight">Monitoring Jamur</h1>
      <div class="flex items-center gap-1.5 mt-0.5">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span class="text-xs font-medium text-slate-500 flex items-center gap-1">
          <span>Live •</span>
          <span id="digital-clock" class="font-mono font-semibold text-slate-700">--:--:-- WITA</span>
        </span>
      </div>
    </div>
  </div>
  <div class="flex items-center gap-3">
    <div class="flex items-center gap-2 px-3 py-1.5 bg-green-50 rounded-full border border-green-100">
      <span class="material-symbols-outlined text-green-600 text-sm" style="font-variation-settings: 'FILL' 1;">wifi</span>
      <span class="hidden sm:inline text-xs font-semibold text-green-700">Connected</span>
    </div>
  </div>
</header>

<script is:inline>
  function updateClock() {
    try {
      const now = new Date();
      const timeString = now.toLocaleTimeString('id-ID', { hour12: false, timeZone: 'Asia/Makassar' }) + ' WITA';
      const el = document.getElementById('digital-clock');
      if (el) el.textContent = timeString;
    } catch (e) {
      const el = document.getElementById('digital-clock');
      if (el) el.textContent = new Date().toLocaleTimeString() + ' WITA';
    }
  }
  updateClock();
  setInterval(updateClock, 1000);
</script>
